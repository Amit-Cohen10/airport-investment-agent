# Copy to backend/.env and fill at least one key. The first configured provider in LLM_PROVIDERS is primary;
# the others are automatic fallbacks on rate limits/outages.
LLM_PROVIDERS=["gemini","groq","anthropic"]

# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# GroqCloud (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic (paid, optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
