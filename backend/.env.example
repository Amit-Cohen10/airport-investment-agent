# Copy to backend/.env and fill at least one key. The first configured provider in LLM_PROVIDERS is primary;
# the others are automatic fallbacks on rate limits/outages. Providers without a key are skipped, so a free
# Gemini key alone is enough.
LLM_PROVIDERS=["anthropic","gemini","groq"]

# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# GroqCloud (free tier): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic Claude (paid, optional): primary when a key is set. The evaluated model is claude-sonnet-5-5.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
